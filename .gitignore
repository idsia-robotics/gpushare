# The top folder is world-writable: ignore everything except the files we track,
# so stray files from other users are never committed by accident.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/docs/
!/bin/
!/setup.sh
!/hosts/
/hosts/*
!/hosts/example.json
!/etc/
!/tests/
!/plugins/
!/.claude-plugin/
__pycache__/
